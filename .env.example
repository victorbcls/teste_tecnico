# LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aurora-support-assistant

# RAG
# Similaridade mínima para um trecho contar como evidência; o padrão 0.3 foi
# calibrado com embeddings falsos de teste e pode precisar de ajuste com nomic-embed-text.
RAG_MIN_SCORE=0.3

# Limits
MAX_ACTIVE_EXECUTIONS=5
TOOL_TIMEOUT_MS=5000
TOOL_MAX_ATTEMPTS=3
