# Usado pelo `docker compose` para substituir as variáveis ${...} em
# docker-compose.yml. Copie para `.env` (nome que o compose lê
# automaticamente) e ajuste. Troque o modelo aqui para trocar o modelo
# usado pelo container `app` e baixado pelo `ollama-pull`.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

RAG_MIN_SCORE=0.3
MAX_ACTIVE_EXECUTIONS=5
TOOL_TIMEOUT_MS=5000
TOOL_MAX_ATTEMPTS=3

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aurora-support-assistant
